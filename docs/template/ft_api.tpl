// Do not edit this file
import axios from "@/utils/request"
import { ApiResp } from "@/types/api"

{{printf "\n"}}

{{- range $t := .Types}}
{{- if and (not (contains $t.TypeName "Req"))}}
{{- if $t.Comment}}/** {{$t.Comment}} */
{{end}}export type {{$t.TypeName}} = {
{{- range $t.Fields}}
  {{.JsonName}}{{if not .IsRequired}}?{{end}}: {{.TsType}}{{if .Comment}} // {{.Comment}}{{end}}
{{- end}}
}

{{end}}
{{- end}}

{{/* ========= API Req ========= */}}
{{- range .APIs}}
{{if .Description}}/** {{.Description}} */
{{end}}
{{- $hasParams := or .PathParams .QueryParams .BodyParams}}
{{- if $hasParams}}
export type {{.APIName}}Req = {
{{- range .PathParams}}
  {{.Name}}: {{.Type}}{{if .Description}} // {{.Description}}{{end}}
{{- end}}
{{- range .QueryParams}}
  {{.Name}}{{if not .IsRequired}}?{{end}}: {{.Type}}{{if .Description}} // {{.Description}}{{end}}
{{- end}}
{{- range .BodyParams}}
  {{.Name}}{{if not .IsRequired}}?{{end}}: {{.Type}}{{if .Description}} // {{.Description}}{{end}}
{{- end}}
}
{{- else}}
{{- end}}

{{end}}

class {{.ClassName}} {
{{range .APIs}}
  {{if .Description}}/** {{.Description}} */
  {{end}}async {{.APIName}}(
    {{- $hasParams := or .PathParams .QueryParams .BodyParams}}
    {{- if $hasParams}}
    req: {{.APIName}}Req
    {{- else}}
    {{- end}}
  ): Promise<ApiResp<{{if .HasResponse}}{{.APIName}}Res{{else}}Record<string, never>{{end}}>>{
    return axios({
      url: `{{.PathTemplate}}`,
      method: "{{.HttpMethod}}",
      {{- if .IsQueryParams}}
      params: { {{- range .QueryParams}}{{.Name}}: req.{{.Name}},{{- end}} },
      {{- end}}
      {{- if .IsBodyParams}}
      data: { {{- range .BodyParams}}{{.Name}}: req.{{.Name}},{{- end}} },
      {{- end}}
    })
  }
{{end}}
}
export default new {{.ClassName}}()